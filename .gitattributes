# Normalise line endings in the repository; check out native line endings.
* text=auto

# Notebook outputs are stripped on commit. The filter is defined per clone:
#   pip install nbstripout
#   nbstripout --install
*.ipynb filter=nbstripout
*.ipynb diff=ipynb

# Binary files: no diff, no line-ending normalisation.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.h5 binary
*.npy binary
*.npz binary
*.pt binary
*.pth binary
